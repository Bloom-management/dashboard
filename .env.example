# Copy to .env.local; placeholders only. Never commit populated env files.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_development_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_development_secret_key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55441
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_development_service_role_key
# Server-only: generate with openssl rand -hex 32; encrypt calendar URLs at rest.
CALENDAR_ENCRYPTION_KEY=replace_with_64_hex_characters

# Optional, only for manually testing the scheduled endpoint; leave unset otherwise.
# CALENDAR_SYNC_SECRET=replace_with_at_least_32_random_characters

# Development issuer host, required by the LOCAL Supabase CLI profile.
CLERK_ISSUER_DOMAIN=replace_with_development_issuer.clerk.accounts.dev

# Local runtime context; use the context containing your existing local data.
BLOOM_DOCKER_CONTEXT=desktop-linux

# Optional local Airbnb polling, managed by npm run dev. Select one existing enabled source.
# BLOOM_CALENDAR_SOURCE_ID=replace_with_existing_airbnb_source_uuid
BLOOM_CALENDAR_INTERVAL_SECONDS=300

# Web push: disabled by default. No hosted schedules are installed by migrations.
BLOOM_PUSH_MODE=off
# For development use test mode + ONLY synthetic verified Clerk subjects (comma separated).
# BLOOM_PUSH_TEST_SUBJECTS=
ONESIGNAL_APP_ID=bb144350-7065-4dfa-b6e2-aa21b7eb2a07
# ONESIGNAL_REST_API_KEY= server-only App API key
# BLOOM_PUSH_SCHEDULER_SECRET= at least 32 random characters; also store in Supabase Vault
